---
interface Props {
  logo?: string;
  scrolledLogo?: string;
}

const { logo = 'logo.png', scrolledLogo } = Astro.props;
---
<a class="brand brand-image" href="#" aria-label="Szept Rzeki — strona główna">
  <img
    class:list={['brand-logo', { 'brand-logo-default': scrolledLogo }]}
    src={`${import.meta.env.BASE_URL}images/${logo}`}
    alt="Szept Rzeki — blisko natury, blisko siebie"
    width="1882"
    height="507"
    decoding="async"
  />
  {scrolledLogo && <img
    class="brand-logo-scrolled"
    src={`${import.meta.env.BASE_URL}images/${scrolledLogo}`}
    alt=""
    width="1882"
    height="507"
    decoding="async"
  />}
</a>
