---
import { Image } from 'astro:assets';
import logoDarkImage from '../assets/images/logo-dark.png';
import logoImage from '../assets/images/logo.png';

interface Props {
  logo?: keyof typeof logos;
  scrolledLogo?: keyof typeof logos;
  href?: string;
}

const logos = {
  'logo-dark.png': logoDarkImage,
  'logo.png': logoImage,
};
const { logo = 'logo.png', scrolledLogo, href = '/' } = Astro.props;
---
<a class="brand brand-image" href={href} aria-label="Szept Rzeki — strona główna">
  <Image
    class:list={['brand-logo', { 'brand-logo-default': scrolledLogo }]}
    src={logos[logo]}
    alt="Szept Rzeki — blisko natury, blisko siebie"
    width={460}
    format="webp"
    quality={90}
  />
  {scrolledLogo && <Image
    class="brand-logo-scrolled"
    src={logos[scrolledLogo]}
    alt=""
    width={460}
    format="webp"
    quality={90}
  />}
</a>
