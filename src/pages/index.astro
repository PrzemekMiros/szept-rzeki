---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
const nav = [['O przystani','o-przystani'],['Atrakcje','atrakcje'],['Oferta','oferta'],['Jak to działa','jak-to-dziala'],['Galeria','galeria'],['FAQ','faq'],['Kontakt','kontakt']];
const attractions = [
 {title:'Kajaki i przygoda',text:'Spójrz na świat z perspektywy rzeki. W swoim tempie, z nurtem i blisko natury.',image:'kayaks',alt:'Żółty kajak na spokojnej rzece',icon:'paddle',color:'mint',detail:'Wiosło w dłoń, codzienność za sobą. Wybierz aktywny dzień na wodzie. Trasy, wyposażenie, zasady bezpieczeństwa i dostępność kajaków wymagają potwierdzenia przez przystań.'},
 {title:'Po prostu odpocznij',text:'Dobra książka, szum wody i nic, co musisz. Znajdź swoją chwilę wytchnienia.',image:'pier',alt:'Drewniany pomost nad wodą',icon:'sun',color:'yellow',detail:'Zabierz ulubioną książkę i pozwól sobie zwolnić. Dostęp do stref wypoczynku, wyposażenie i warunki pobytu zostaną podane po potwierdzeniu oferty.'},
 {title:'Najlepiej razem',text:'Małe radości mają większy sens, kiedy dzielisz je z ludźmi, których lubisz.',image:'adventure',alt:'Grupa osób wspólnie płynących kajakami',icon:'people',color:'pink',detail:'Zaplanuj czas z rodziną lub przyjaciółmi. Wielkość grupy, szczegóły organizacji i dostępne atrakcje należy uzgodnić z przystanią.'},
 {title:'Bliżej natury',text:'Zieleń, śpiew ptaków i ścieżki, które prowadzą dalej od codziennego pośpiechu.',image:'forest',alt:'Słońce przenikające przez zielony las',icon:'leaf',color:'blue',detail:'Zatrzymaj się przy drobnych rzeczach: świetle między liśćmi, szumie drzew, odbiciu nieba w wodzie. Informacje o lokalnych ścieżkach zostaną uzupełnione po potwierdzeniu lokalizacji.'},
];
const benefits = [['leaf','Natura na wyciągnięcie ręki','Zieleń, woda i przestrzeń, by złapać oddech.'],['waves','Spokój ma swój adres','Zwolnij i wsłuchaj się w rytm rzeki.'],['paddle','Po swojemu, w swoim tempie','Trochę ruchu lub popołudnie nicnierobienia.'],['people','Razem smakuje lepiej','Przestrzeń na rozmowy i wspólne wspomnienia.'],['sun','Mały reset. Duża różnica.','Odpoczynek od ekranów i codziennego pośpiechu.'],['heart','Chwile, które zostają','Zwykły dzień, do którego chce się wracać.']];
const steps = [['Wybierz atrakcję','Znajdź swój pomysł na idealny dzień nad rzeką.'],['Zaplanuj termin','Wybierz preferowany dzień i porę wizyty.'],['Potwierdź szczegóły','Uzgodnij dostępność i warunki z przystanią.'],['Przyjedź i odpocznij','Resztę zostaw za sobą. Teraz jest Twój czas.']];
const offers = [
 {name:'Aktywnie nad wodą',icon:'paddle',desc:'Dla tych, których ciekawość niesie z nurtem.',items:['Pomysł na kajakową przygodę','Czas na odkrywanie rzeki','Ruch i bliskość natury'],value:'Kajaki i aktywność'},
 {name:'Relaks na przystani',icon:'sun',desc:'Mniej planów. Więcej chwil tylko dla siebie.',items:['Pomysł na spokojny dzień','Odpoczynek nad brzegiem','Przestrzeń na małe przyjemności'],value:'Relaks na przystani'},
 {name:'Czas razem',icon:'people',desc:'Dla par, rodzin i dobrego towarzystwa.',items:['Pomysł na wspólny wypoczynek','Plan dopasowany do grupy','Wspomnienia, które łączą'],value:'Czas razem'},
];
const reviews = [['„Dokładnie takiego odpoczynku potrzebowaliśmy. Bez pośpiechu, blisko wody i po prostu razem.”','Anna','Rodzinny dzień nad rzeką','A'],['„Najlepszy plan na wolny dzień? Kajak, natura i wyłączony telefon. Chętnie powtórzymy!”','Michał','Aktywny wypoczynek','M'],['„Są miejsca, w których od razu bierzesz głębszy oddech. Tak wyobrażam sobie idealny weekend.”','Kasia','Chwila dla siebie','K'],['„Kawa, książka i widok na wodę. Czasem do szczęścia nie potrzeba niczego więcej.”','Paweł','Spokojne popołudnie','P']];
const gallery = [['river','Poranki pełne spokoju','Kiedy świat dopiero się budzi.'],['kayaks','Przygoda na wodzie','Najlepsze historie płyną z nurtem.'],['pier','Chwile, które zostają','Jeszcze moment. Nigdzie się nie spieszymy.']];
const faqs = [
 ['Gdzie znajduje się przystań?','Dokładny adres i wskazówki dojazdu pojawią się po potwierdzeniu danych obiektu. Zdjęcia na stronie są inspiracjami i nie przedstawiają potwierdzonej lokalizacji przystani.'],
 ['Czy trzeba wcześniej rezerwować termin?','Przed przyjazdem warto potwierdzić dostępność wybranej atrakcji. Obecny kalendarz służy do przygotowania planu wizyty i nie sprawdza rzeczywistej dostępności.'],
 ['Jakie atrakcje są dostępne na miejscu?','Kajaki, relaks nad wodą, wspólny wypoczynek i odkrywanie natury to propozycje przedstawione w projekcie. Ostateczny zakres atrakcji zostanie potwierdzony przez przystań.'],
 ['Czy przystań jest odpowiednia dla rodzin z dziećmi?','Przed wizytą należy potwierdzić dostępność udogodnień oraz zasady udziału dzieci w atrakcjach. Nad wodą dzieci powinny pozostawać pod stałą opieką osoby dorosłej.'],
 ['Co warto zabrać ze sobą?','Wygodny strój dopasowany do pogody, wodę do picia, nakrycie głowy i ochronę przeciwsłoneczną. Jeśli planujesz aktywność na wodzie, przygotuj też ubranie na zmianę.'],
 ['Czy można zorganizować spotkanie grupowe?','Czas razem to proponowany wariant wypoczynku. Możliwość organizacji spotkania, wielkość grupy i szczegóły należy wcześniej potwierdzić z przystanią.'],
 ['Czy są miejsca parkingowe?','Informacje o parkingu, jego lokalizacji i ewentualnych opłatach zostaną uzupełnione po potwierdzeniu przez obiekt.'],
 ['Jak wygląda rezerwacja i płatność?','Możesz utworzyć i pobrać plan wizyty. Nie jest on rezerwacją, nie jest wysyłany do przystani i nie wymaga płatności. Rezerwacje online zostaną udostępnione po uruchomieniu systemu.'],
];
---
<!doctype html>
<html lang="pl">
<head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="description" content="Szept Rzeki — miejsce na spokojny odpoczynek, bliskość natury i wspólne chwile nad wodą. Poznaj pomysły na swój dzień nad rzeką."/>
 <meta name="theme-color" content="#176B50"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
 <link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
 <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700;750&family=Manrope:wght@400;500;600;650;700;750;800&display=swap" rel="stylesheet"/>
 <title>Szept Rzeki — zwolnij tempo, odpocznij nad rzeką</title>
</head>
<body>
<a class="skip-link" href="#main">Przejdź do treści</a>
<header class="site-header"><div class="container header-inner">
 <a class="brand" href="#" aria-label="Szept Rzeki — strona główna"><span class="brand-icon"><Icon name="waves" size={31}/></span><span>szept rzeki<span class="brand-caption">BLISKO NATURY. BLISKO SIEBIE.</span></span></a>
 <nav id="main-nav" aria-label="Nawigacja główna">{nav.map(([label,id])=><a href={`#${id}`}>{label}</a>)}</nav>
 <a class="button small header-book" href="#rezerwacja">Zarezerwuj <Icon name="arrow" size={17}/></a>
 <button class="menu-toggle icon-button" aria-label="Otwórz menu" aria-expanded="false" aria-controls="main-nav"><Icon name="menu"/></button>
</div></header>
<main id="main">
<section class="hero"><div class="container hero-grid"><div class="hero-copy">
 <span class="eyebrow"><span class="tiny-dot"></span> TWOJE MIEJSCE BLISKO NATURY</span>
 <h1>Zwolnij tempo.<br/>Odpocznij<br/><span class="underlined">nad rzeką.<svg viewBox="0 0 365 18" aria-hidden="true"><path d="M3 12Q172-3 360 9M20 17Q172 7 330 13"/></svg></span></h1>
 <p>Odkryj miejsce, w którym czas płynie wolniej.<br class="desktop-break"/> Blisko natury, z dala od pośpiechu. Przyjedź po spokój,<br class="desktop-break"/> małe przygody i wielkie chwile z bliskimi.</p>
 <div class="button-row"><a class="button" href="#o-przystani">Poznaj naszą przystań <Icon name="arrow" size={18}/></a><a class="text-button" href="#atrakcje">Zobacz atrakcje <span class="circle-arrow"><Icon name="arrow" size={16}/></span></a></div>
 <div class="hero-perks"><span><Icon name="leaf" size={17}/> Blisko natury</span><span><Icon name="paddle" size={17}/> Aktywny wypoczynek</span><span><Icon name="heart" size={17}/> Wspólny czas</span></div>
</div><div class="hero-visual"><div class="hero-blob"></div><div class="sun-decoration" aria-hidden="true"><Icon name="sun" size={80}/></div>
 <img class="hero-photo" src="/images/pier.jpg" alt="Drewniany pomost nad spokojną wodą otoczoną lasem — zdjęcie inspiracyjne" width="600" height="650" fetchpriority="high"/>
 <div class="floating-tag"><span class="tag-icon"><Icon name="leaf" size={22}/></span><div>Wdech. Wydech.<strong>Jesteś blisko natury.</strong></div></div>
 <div class="floating-note"><span class="note-sun"><Icon name="sun" size={27}/></span><div>Dobry dzień zaczyna się<strong>nad rzeką.</strong></div><span class="note-heart">♡</span></div>
 <span class="image-caption">MNIEJ POŚPIECHU, WIĘCEJ ŻYCIA</span>
</div></div><div class="container hero-bottom"><span><span class="tiny-dot"></span> Zostaw codzienność na brzegu.</span><a href="#atrakcje">Daj się ponieść <span>↓</span></a><span>Twój mały reset zaczyna się tutaj.</span></div></section>
<section class="section attractions" id="atrakcje"><div class="container"><div class="section-heading centered"><span class="eyebrow mint">PO TWOJEMU</span><h2>Odkryj swój sposób<br/>na <span>wypoczynek.</span></h2><p>Trochę przygody czy odrobina nicnierobienia?<br/>Nad rzeką jest przestrzeń na jedno i drugie.</p></div>
 <div class="attraction-grid">{attractions.map(item=><article class={`attraction-card ${item.color}`}><div class="card-image"><img src={`/images/${item.image}.jpg`} alt={item.alt} width="600" height="440" loading="lazy"/><span class="card-icon"><Icon name={item.icon}/></span></div><div class="card-body"><h3>{item.title}</h3><p>{item.text}</p><button class="inline-link" data-detail-title={item.title} data-detail={item.detail}>Dowiedz się więcej <Icon name="arrow" size={18}/></button></div></article>)}</div><p class="section-note">Pomysły na wypoczynek — ostateczny zakres atrakcji wymaga potwierdzenia.</p>
</div></section>
<section class="section benefits"><div class="container"><div class="section-heading centered"><span class="eyebrow">DOBRZE BYĆ TUTAJ</span><h2>Wszystko, czego potrzebujesz,<br/>by <span>naprawdę odpocząć.</span></h2></div><div class="benefit-grid">{benefits.map(([icon,title,desc],i)=><article><span class={`benefit-icon ${['mint','yellow','pink'][i%3]}`}><Icon name={icon} size={28}/></span><h3>{title}</h3><p>{desc}</p></article>)}</div></div></section>
<section class="section about" id="o-przystani"><div class="container about-grid"><div class="about-visual"><img src="/images/river.jpg" alt="Zielony brzeg i pomost odbijające się w wodzie — inspiracja" width="650" height="700" loading="lazy"/><div class="about-stamp"><Icon name="waves" size={32}/><span>Z miłości<br/><strong>do prostych chwil.</strong></span></div></div><div class="about-copy"><span class="eyebrow mint">POZNAJ SZEPT RZEKI</span><h2>Miejsce, w którym<br/><span>natura gra</span><br/>pierwsze skrzypce.</h2><p>Szept Rzeki to pomysł na przestrzeń stworzoną z miłości do natury, spokoju i prostych przyjemności.</p><p>Tutaj codzienny pośpiech ustępuje miejsca szumowi wody. Możesz nacieszyć się zielenią, pobyć z bliskimi i spędzić dzień dokładnie tak, jak lubisz. Bez wielkich planów. Z przestrzenią dla siebie.</p><div class="about-perks"><span><Icon name="leaf" size={20}/> Naturalnie i bez pośpiechu</span><span><Icon name="heart" size={20}/> Z bliskimi, blisko siebie</span></div><button class="button" data-detail-title="Z miłości do prostych chwil" data-detail="Idea Szeptu Rzeki zaczyna się od prostego pragnienia: znaleźć przestrzeń, w której można zwolnić, popatrzeć na wodę i pobyć razem. To opowieść o wartościach miejsca. Autentyczna historia przystani i jej gospodarzy zostanie uzupełniona przed publikacją.">Poznaj naszą historię <Icon name="arrow" size={18}/></button></div></div></section>
<section class="section steps" id="jak-to-dziala"><div class="container"><div class="section-heading centered"><span class="eyebrow yellow">TO PROSTSZE, NIŻ MYŚLISZ</span><h2>Twój wypoczynek<br/><span>zaczyna się tutaj.</span></h2></div><div class="steps-grid">{steps.map(([title,desc],i)=><article><div class="step-number">0{i+1}</div><h3>{title}</h3><p>{desc}</p></article>)}</div></div></section>
<section class="section offers" id="oferta"><div class="container"><div class="section-heading centered"><span class="eyebrow mint">DOBRY PLAN NA WOLNE</span><h2>Wybierz swój sposób<br/>na <span>dzień nad rzeką.</span></h2><p>Każdy odpoczywa inaczej. I to jest w tym najlepsze.</p></div><div class="offer-grid">{offers.map((offer,i)=><article class:list={['offer-card',{'featured':i===1}]}>{i===1&&<span class="offer-ribbon"><Icon name="sun" size={15}/> WIĘCEJ CZASU DLA SIEBIE</span>}<span class="offer-icon"><Icon name={offer.icon} size={30}/></span><h3>{offer.name}</h3><p>{offer.desc}</p><div class="offer-price">Zapytaj o cenę<span>Zakres i wycena do potwierdzenia</span></div><ul>{offer.items.map(item=><li><Icon name="check" size={18}/>{item}</li>)}</ul><a href="#rezerwacja" class={`button ${i===1?'':'outline'}`} data-offer={offer.value}>Zaplanuj wizytę <Icon name="arrow" size={18}/></a></article>)}</div><p class="section-note">Przedstawione warianty są propozycjami. Ceny i szczegóły pojawią się po potwierdzeniu oferty przystani.</p></div></section>
<section class="section booking" id="rezerwacja"><div class="container"><div class="section-heading centered"><span class="eyebrow mint">ZRÓB MIEJSCE NA ODPOCZYNEK</span><h2>Zaplanuj swój czas<br/><span>nad rzeką.</span></h2><p>Wybierz swój pomysł na dzień. Reszta może chwilę poczekać.</p></div><div class="booking-panel">
 <div class="booking-options"><span class="step-label">01 / TWÓJ POMYSŁ</span><h3>Jak chcesz odpocząć?</h3><label for="activity">Rodzaj wypoczynku</label><select id="activity"><option>Kajaki i aktywność</option><option selected>Relaks na przystani</option><option>Czas razem</option></select><label for="participants">Liczba uczestników</label><div class="number-input"><button id="decrease" aria-label="Mniej uczestników">−</button><input id="participants" type="number" min="1" max="30" value="2"/><button id="increase" aria-label="Więcej uczestników">+</button></div><div class="booking-notice"><Icon name="info" size={20}/><p><strong>Plan wizyty — wersja pokazowa</strong>Daty i godziny oznaczają preferencje, nie potwierdzoną dostępność. Nie dokonujesz rezerwacji ani płatności.</p></div></div>
 <div class="calendar-panel"><span class="step-label">02 / TWÓJ DZIEŃ</span><div class="calendar-heading"><h3 id="calendar-month" aria-live="polite"></h3><div><button id="prev-month" class="icon-button" aria-label="Poprzedni miesiąc"><Icon name="chevron" class="rotate" size={18}/></button><button id="next-month" class="icon-button" aria-label="Następny miesiąc"><Icon name="chevron" size={18}/></button></div></div><div class="weekdays">{['Pon','Wt','Śr','Czw','Pt','Sob','Nd'].map(day=><span>{day}</span>)}</div><div id="calendar-days" class="calendar-days" role="group" aria-label="Wybierz preferowany dzień"></div><div class="calendar-legend"><span></span> Wybrany dzień <span></span> Dzień w podglądzie</div><fieldset class="time-picker"><legend>Preferowana godzina <span>(podgląd)</span></legend>{['09:00','11:00','13:00','15:00'].map(time=><label><input type="radio" name="time" value={time}/><span>{time}</span></label>)}</fieldset></div>
 <div class="booking-summary"><span class="step-label">03 / TWÓJ MAŁY RESET</span><h3>Brzmi jak dobry plan.</h3><div class="summary-row"><Icon name="leaf" size={20}/><span id="summary-activity">Relaks na przystani</span></div><div class="summary-row"><Icon name="calendar" size={20}/><span id="summary-date">Wybierz dzień</span></div><div class="summary-row"><Icon name="clock" size={20}/><span id="summary-time">Wybierz godzinę</span></div><div class="summary-row"><Icon name="people" size={20}/><span id="summary-people">Liczba osób: 2</span></div><div class="summary-price"><span>Cena i dostępność</span><strong>Do potwierdzenia</strong></div><button class="button" id="booking-continue" disabled>Przejdź do rezerwacji <Icon name="arrow" size={18}/></button><p>Podgląd podsumowania.<br/>Rezerwacje online jeszcze nie są uruchomione.</p><span id="booking-status" class="sr-only" aria-live="polite"></span></div>
</div></div></section>
<section class="section testimonials"><div class="container"><div class="section-heading heading-row"><div><span class="eyebrow pink">DOBRE CHWILE, DOBRE SŁOWA</span><h2>Chwile, do których<br/><span>chce się wracać.</span></h2></div><div class="slider-controls"><button id="reviews-prev" class="icon-button" aria-label="Poprzednie opinie"><Icon name="arrow" class="rotate"/></button><button id="reviews-next" class="icon-button" aria-label="Następne opinie"><Icon name="arrow"/></button></div></div><p class="demo-note">Przykładowe opinie — element projektu, nie autentyczne recenzje gości.</p><div class="reviews-track" id="reviews-track">{reviews.map(([quote,name,desc,letter],i)=><article class="review-card"><div class="stars" aria-label="Przykładowa ocena: 5 na 5">★★★★★</div><blockquote>{quote}</blockquote><div class="review-person"><span class={`avatar ${['mint','pink','yellow'][i%3]}`}>{letter}</span><div><strong>{name}</strong><span>{desc}</span></div><span class="quote-mark">”</span></div></article>)}</div></div></section>
<section class="section gallery" id="galeria"><div class="container"><div class="section-heading heading-row"><div><span class="eyebrow mint">ZATRZYMANE W KADRZE</span><h2>Zobacz, jak wygląda<br/><span>życie nad rzeką.</span></h2></div><span class="gallery-aside"><Icon name="camera" size={21}/> Małe chwile. Wielkie wspomnienia.</span></div><div class="gallery-grid">{gallery.map(([image,title,desc])=><article><button class="gallery-image" data-gallery={`/images/${image}.jpg`} data-caption={title} aria-label={`Powiększ zdjęcie: ${title}`}><img src={`/images/${image}.jpg`} alt={`${title} — fotografia inspiracyjna`} width="720" height="560" loading="lazy"/><span><Icon name="arrow"/></span></button><h3>{title}</h3><p>{desc}</p><button class="inline-link" data-gallery={`/images/${image}.jpg`} data-caption={title}>Zobacz więcej <Icon name="arrow" size={17}/></button></article>)}</div><p class="section-note">Fotografie inspiracyjne z Unsplash. Nie przedstawiają rzeczywistego obiektu.</p></div></section>
<section class="section faq" id="faq"><div class="container faq-grid"><div class="section-heading"><span class="eyebrow yellow">DOBRZE WIEDZIEĆ</span><h2>Przed wizytą?<br/><span>Rozwiejmy<br/>wątpliwości.</span></h2><p>Wszystko, co warto wiedzieć,<br/>zanim zostawisz pośpiech za sobą.</p><a class="text-button" href="#kontakt">Przejdź do kontaktu <Icon name="arrow" size={18}/></a></div><div class="faq-list">{faqs.map(([question,answer],i)=><details name="faq" open={i===0}><summary>{question}<span class="faq-plus">+</span></summary><p>{answer}</p></details>)}</div></div></section>
<section class="final-cta"><div class="container cta-box"><div class="cta-copy"><span class="eyebrow">DO ZOBACZENIA NAD WODĄ</span><h2>Najpiękniejsze chwile<br/>płyną <span>własnym rytmem.</span></h2><p>Czasem wystarczy odrobina spokoju, szum wody i dobre towarzystwo. Znajdź swoje ulubione miejsce nad rzeką.</p><div class="button-row"><a class="button" href="#rezerwacja">Zaplanuj wizytę <Icon name="arrow" size={18}/></a><a class="text-button" href="#galeria">Zobacz galerię <Icon name="arrow" size={18}/></a></div></div><div class="cta-photo"><img src="/images/pier.jpg" alt="Spokojny pomost otoczony lasem" width="600" height="600" loading="lazy"/><span class="cta-sun"><Icon name="sun" size={65}/></span></div></div></section>
</main>
